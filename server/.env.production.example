# [PRODUCTION CONFIGURATION GUIDELINES]
# Copy this file to .env.production on production server deployment.
# NEVER commit the actual .env.production containing real secrets to Git.

PORT=5000
NODE_ENV=production

# Production PostgreSQL Database Connection
# Recommendation: Use connection pooling (PgBouncer) and enforce SSL (sslmode=require)
DATABASE_URL="postgresql://khazprokhir_user:CHANGE_ME_IN_PRODUCTION@postgres-prod-host:5432/khazprokhir_prod?sslmode=require&connection_limit=20"

# Strict CORS Whitelist: only allow the official frontend production domain
CORS_ORIGIN="https://khazprokhir.peruri.co.id"

# Cryptographically strong secret key for JWT token signing
JWT_SECRET="GENERATE_A_64_CHAR_RANDOM_SECRET_KEY_FOR_PRODUCTION_SECURITY"
JWT_EXPIRES_IN="8h"
